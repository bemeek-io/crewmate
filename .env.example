# --- Required ----------------------------------------------------------------

# Public origin the app is served from (the proxy's hostname). Push, secure
# cookies, and the service worker require HTTPS in production.
APP_BASE_URL=https://crew.example.com
APP_DOMAIN=crew.example.com

# Postgres password (compose wires DATABASE_URL automatically).
POSTGRES_PASSWORD=change-me

# 32 random bytes, base64 — encrypts Crew bearer tokens at rest.
# Generate with: openssl rand -base64 32
CREW_TOKEN_ENC_KEY=

# Web Push VAPID keys. Generate once with: go run ./cmd/crewmate -generate-vapid
# (or: docker compose run --rm --entrypoint /crewmate app -generate-vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Optional ----------------------------------------------------------------

# Anthropic API key for LLM auto-categorization of unknown merchants.
# Leave empty to disable (users categorize by hand via push prompt).
ANTHROPIC_API_KEY=

#LOG_LEVEL=info
#LISTEN_ADDR=:8080
#SESSION_TTL=4320h
#WATCH_INTERVAL=60s
#LEASE_TTL=60s
#BACKFILL_MONTHS=12
#MAX_CONNECTIONS_PER_REPLICA=0
